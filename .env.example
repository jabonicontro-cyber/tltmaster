# Copy to .env.local and fill in. Never commit real values.

# Supabase project (Settings → API). The anon key is public and protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Used to invite users and by scripts/create-owner.mjs.
# NEVER expose this to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of this app (used in password-reset and invitation links).
APP_BASE_URL=http://localhost:3000

# Early-access gate (server only; see docs/DEPLOYMENT.md).
#   EARLY_ACCESS_GATE  on | off. Default: on in production builds, off in `npm run dev`.
#   SITE_ACCESS_SECRET at least 32 random characters, e.g. `openssl rand -base64 32`.
#                      Required when the gate is on (the app refuses all requests without it).
#                      Changing it signs every device out of early access.
#   EARLY_ACCESS_DAYS  days a device stays admitted (1-90, default 30)
#   EARLY_ACCESS_RECHECK_SECONDS  how often a device's access is re-checked (default 300)
EARLY_ACCESS_GATE=
SITE_ACCESS_SECRET=
EARLY_ACCESS_DAYS=
EARLY_ACCESS_RECHECK_SECONDS=

# Public website (marketing pages and the demo/contact form).
#   PUBLIC_SITE    on = open to everyone; empty = behind the early-access gate (when the gate is on)
#   SITE_INDEXING  on = search engines may index the public pages only (read at build time); default off
PUBLIC_SITE=
SITE_INDEXING=

# Email delivery for quotes.
#   preview → nothing is sent; the app shows exactly what would be sent (default)
#   resend  → send through Resend (https://resend.com); requires the two values below
EMAIL_PROVIDER=preview
RESEND_API_KEY=
# A verified sender on your Resend domain, e.g. "Top Line Trucking <quotes@yourdomain.com>"
EMAIL_FROM=
# Optional: reply-to address for quote emails
EMAIL_REPLY_TO=
# Optional test mode: when set, EVERY email goes to this address instead of the
# customer, the subject is prefixed [TEST], and quotes are NOT marked sent.
EMAIL_TEST_RECIPIENT=
# Optional: the Taviron team's inbox for new website leads. Website lead emails
# use the same provider settings; with EMAIL_PROVIDER=preview nothing is sent.
LEAD_NOTIFY_EMAIL=

# AI (docs/AI.md). Server only — never NEXT_PUBLIC_. A key alone switches nothing on:
# a capability also needs AI_CAPABILITIES, its model, a monthly token limit, the usage-ledger
# migration and passing evaluation evidence for that model. Leave empty to keep AI off.
AI_PROVIDER=
# Set in the hosting provider's environment settings; never commit a real key.
OPENAI_API_KEY=
# Comma-separated capabilities to switch on, e.g. plan_explanation
AI_CAPABILITIES=
# Model id per capability (no default; see docs/AI.md §5 for the evaluation it needs)
AI_MODEL_PLAN_EXPLANATION=
# Optional approved fallback (used only with its own passing evaluation evidence)
AI_FALLBACK_MODEL_PLAN_EXPLANATION=
# Reported tokens per company per calendar month (required to run anything)
AI_MONTHLY_TOKEN_LIMIT=
# Optional (defaults 6 and 20000)
AI_REQUESTS_PER_MINUTE=
AI_TIMEOUT_MS=
# Optional prices for cost estimates, USD per million tokens:
# {"<model>": {"inputPerMillion": 0, "outputPerMillion": 0}}
AI_PRICING_JSON=
# on = demo companies may call the model too (default off)
AI_IN_DEMOS=

# Database tests (npm run test:db): superuser connection to a migrated database.
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:54322/postgres

# QuickBooks Online (optional, master plan B82; owner steps in DEPLOYMENT §2d). Server-only; never NEXT_PUBLIC_.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# sandbox (default) or production
QBO_ENVIRONMENT=sandbox
